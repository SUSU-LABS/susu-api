# susu-api — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# SECURITY: every value here is server-only. None of these may ever be exposed to
# the browser. `VITE_`-prefixed variables belong to susu-web and are public by
# definition — do not put these values there.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Bind to all interfaces so container/Render routing works.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Database (server-only). The database is a rebuildable index, never the
# source of truth. Chain state always wins.
#
# Hosted Postgres requires TLS, and the API configures it explicitly, so do NOT
# append `sslmode=` here — modern `pg` reads `sslmode=require` as `verify-full`,
# which fails against Supabase's self-signed pooler chain.
#
# The Supabase direct host (`db.<ref>.supabase.co`) publishes only an IPv6
# address; on an IPv4-only network use the pooler instead:
#   postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# The API refuses to start against a remote database it cannot authenticate,
# because an encrypted-but-unverified connection behaves identically to a
# verified one and would never be noticed. Resolve it one of two ways:
#
#   1. Set DATABASE_SSL_CA (preferred). Supabase publishes its CA at Project
#      Settings -> Database -> SSL configuration. Multi-line PEM is fine.
#      IMPORTANT: take the CA from the dashboard, never from the connection
#      itself — a CA captured over the channel it is meant to secure is
#      trust-on-first-use, and an attacker present at capture time would supply
#      their own root to be pinned permanently.
#
#   2. Set DATABASE_SSL_ALLOW_UNVERIFIED=true to accept the gap. The name is
#      deliberate: this acknowledges a machine-in-the-middle risk, it does not
#      enable a feature.
#
# Local development needs neither; localhost is detected and uses plain TCP.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL_CA=
DATABASE_SSL_ALLOW_UNVERIFIED=false

# ---------------------------------------------------------------------------
# Supabase (server-only). The service-role key bypasses RLS: it must never be
# used in browser code and must never be logged.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stellar
# Mainnet is out of scope until the Mainnet readiness gate is passed.
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet
# Read-only RPC access. Used to simulate invocations for POST
# /api/v1/transactions/prepare; this service never signs or submits.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Public addresses / contract IDs (C... and G... values are public).
FACTORY_CONTRACT_ID=
USDC_CONTRACT_ID=
TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# Protocol constants — must match the deployed contracts exactly.
# PROTOCOL_FEE_BPS is a financial invariant; the API refuses to start if it
# differs from 50. Changing it requires human review.
# ---------------------------------------------------------------------------
PROTOCOL_FEE_BPS=50

# ---------------------------------------------------------------------------
# Wallet linking. Must be at least 32 characters. Rotating this invalidates
# outstanding nonces.
# ---------------------------------------------------------------------------
WALLET_NONCE_SECRET=

# ---------------------------------------------------------------------------
# Safety switch. The API refuses to start on Mainnet unless this is "true".
# ---------------------------------------------------------------------------
ALLOW_MAINNET=false

# ---------------------------------------------------------------------------
# CORS — strict comma-separated allowlist. Empty means no cross-origin access.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Trusted proxy CIDRs (comma-separated).
# Restricts trustProxy to known reverse proxies (e.g. Render private ranges)
# so clients cannot spoof X-Forwarded-For headers to evade rate limits.
# ---------------------------------------------------------------------------
TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# Optional S3-compatible storage (server-only credentials).
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
